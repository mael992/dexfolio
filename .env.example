# Copie ce fichier en `.env.local` pour le développement local.
# Ces deux valeurs sont PUBLIQUES par conception (clé "anon"/"publishable") :
# la sécurité des données repose sur les règles RLS de Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Chemin de base (rempli automatiquement par GitHub Actions : /nom-du-depot/)
# VITE_BASE_PATH=/

# Sans Supabase configuré, l'app fonctionne en "mode local" (données dans le navigateur).
